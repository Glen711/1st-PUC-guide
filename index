              </span>
            `
          },
          {
            title: "Add",
            text: `
              The cosXsinY terms cancel:
              <span class="equation">
                2sinXcosY
              </span>
            `
          },
          {
            title: "Substitute",
            text: `
              <span class="equation">
                sinA + sinB =
                2sin[(A+B)/2]cos[(A−B)/2]
              </span>
            `
          }
        ],
        trap: "Interchanging the final sin and cos factors.",
        hack: "SIN + SIN = 2 SIN COS.",
        formula: "sinA + sinB = 2sin[(A+B)/2]cos[(A−B)/2]"
      },

      {
        id: 34,
        category: "Mathematics",
        title: "Sum-to-Product — sinA − sinB",
        priority: "HIGH",
        start: `
          Let:
          <span class="equation">X=(A+B)/2</span>
          and
          <span class="equation">Y=(A−B)/2</span>.
        `,
        steps: [
          {
            title: "Rewrite",
            text: `
              <span class="equation">
                sinA − sinB = sin(X+Y) − sin(X−Y)
              </span>
            `
          },
          {
            title: "Expand",
            text: `
              <span class="equation">
                = (sinXcosY+cosXsinY)
                − (sinXcosY−cosXsinY)
              </span>
            `
          },
          {
            title: "Cancel",
            text: `
              The sinXcosY terms cancel:
              <span class="equation">
                2cosXsinY
              </span>
            `
          },
          {
            title: "Substitute",
            text: `
              <span class="equation">
                sinA − sinB =
                2cos[(A+B)/2]sin[(A−B)/2]
              </span>
            `
          }
        ],
        trap: "Writing 2sin cos instead of 2cos sin.",
        hack: "SIN − SIN = 2 COS SIN.",
        formula: "sinA − sinB = 2cos[(A+B)/2]sin[(A−B)/2]"
      }

    ];


    /*
      ============================================================
      DASHBOARD RENDERING
      ============================================================
    */

    const topicList = document.getElementById("topicList");
    const emptyState = document.getElementById("emptyState");
    const searchInput = document.getElementById("searchInput");

    let currentFilter = "All";

    function renderTopics() {

      const query = searchInput.value.trim().toLowerCase();

      const filtered = topics.filter(topic => {

        const matchesCategory =
          currentFilter === "All" ||
          topic.category === currentFilter;

        const searchableText = [
          topic.title,
          topic.category,
          topic.start,
          topic.trap,
          topic.hack,
          topic.formula,
          ...topic.steps.map(step => step.title + " " + step.text)
        ].join(" ").toLowerCase();

        const matchesSearch =
          !query || searchableText.includes(query);

        return matchesCategory && matchesSearch;

      });

      topicList.innerHTML = "";

      filtered.forEach(topic => {

        const card = document.createElement("article");

        card.className = "topic-card";

        const priorityClass =
          topic.priority.toLowerCase() === "high"
            ? "high"
            : "medium";

        card.innerHTML = `

          <div class="topic-header">

            <div class="topic-header-left">

              <div class="subject-badge subject-${topic.category}">
                ${topic.category}
              </div>

              <h3 class="topic-title">
                ${topic.id}. ${topic.title}
              </h3>

            </div>

            <div class="priority ${priorityClass}">
              ${topic.priority}
            </div>

          </div>


          <div class="topic-body">

            <div class="start-box">

              <div class="label">
                Starting Point
              </div>

              <p>
                ${topic.start}
              </p>

            </div>


            <div class="step-section">

              <h4>Step-by-Step Flow</h4>

              <ol class="steps">

                ${topic.steps.map(step => `
                  <li>
                    <strong>${step.title}</strong>
                    <div>${step.text}</div>
                  </li>
                `).join("")}

              </ol>

            </div>


            <div class="support-grid">

              <div class="trap-box">

                <h4>🚨 Common Trap</h4>

                <div>
                  ${topic.trap}
                </div>

              </div>


              <div class="hack-box">

                <h4>🧠 Memory Hack</h4>

                <div>
                  ${topic.hack}
                </div>

              </div>


              <div class="final-box">

                <h4>📌 Final Formula</h4>

                <div class="final-formula">
                  ${topic.formula}
                </div>

              </div>

            </div>

          </div>

        `;

        topicList.appendChild(card);

      });

      emptyState.hidden = filtered.length !== 0;
    }


    /*
      ============================================================
      FILTERS
      ============================================================
    */

    document.querySelectorAll(".filter-btn").forEach(button => {

      button.addEventListener("click", () => {

        document.querySelectorAll(".filter-btn")
          .forEach(btn => btn.classList.remove("active"));

        button.classList.add("active");

        currentFilter = button.dataset.filter;

        renderTopics();

      });

    });

    searchInput.addEventListener("input", renderTopics);

    renderTopics();


    /*
      ============================================================
      FLASHCARD DECK
      ============================================================
    */

    const flashCard = document.getElementById("flashCard");
    const flashCategory = document.getElementById("flashCategory");
    const flashCounterTop = document.getElementById("flashCounterTop");
    const flashTopic = document.getElementById("flashTopic");
    const flashBackTitle = document.getElementById("flashBackTitle");
    const flashHack = document.getElementById("flashHack");
    const flashFormula = document.getElementById("flashFormula");

    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const flipBtn = document.getElementById("flipBtn");
    const shuffleBtn = document.getElementById("shuffleBtn");

    const deckCurrent = document.getElementById("deckCurrent");
    const deckTotal = document.getElementById("deckTotal");
    const deckTopic = document.getElementById("deckTopic");
    const progressFill = document.getElementById("progressFill");
    const deckList = document.getElementById("deckList");

    let deck = [...topics];
    let flashIndex = 0;


    function updateDeckList() {

      deckList.innerHTML = "";

      deck.forEach((topic, index) => {

        const item = document.createElement("button");

        item.className =
          "deck-item" +
          (index === flashIndex ? " active" : "");

        item.textContent =
          `${index + 1}. ${topic.title}`;

        item.addEventListener("click", () => {

          flashIndex = index;

          flashCard.classList.remove("flipped");

          updateFlashcard();

          document.getElementById("flashcards")
            .scrollIntoView({
              behavior: "smooth",
              block: "start"
            });

        });

        deckList.appendChild(item);

      });

    }


    function updateFlashcard() {

      const topic = deck[flashIndex];

      flashCategory.textContent =
        topic.category.toUpperCase();

      flashCounterTop.textContent =
        `CARD ${flashIndex + 1} OF ${deck.length}`;

      flashTopic.textContent =
        topic.title;

      flashBackTitle.textContent =
        topic.title;

      flashHack.textContent =
        topic.hack;

      flashFormula.innerHTML =
        topic.formula;

      deckCurrent.textContent =
        flashIndex + 1;

      deckTotal.textContent =
        deck.length;

      deckTopic.textContent =
        topic.title;

      const progress =
        ((flashIndex + 1) / deck.length) * 100;

      progressFill.style.width =
        progress + "%";

      prevBtn.disabled =
        flashIndex === 0;

      nextBtn.disabled =
        flashIndex === deck.length - 1;

      updateDeckList();

    }


    function flipCard() {

      flashCard.classList.toggle("flipped");

    }


    function nextCard() {

      if (flashIndex < deck.length - 1) {

        flashIndex++;

        flashCard.classList.remove("flipped");

        updateFlashcard();

      }

    }


    function previousCard() {

      if (flashIndex > 0) {

        flashIndex--;

        flashCard.classList.remove("flipped");

        updateFlashcard();

      }

    }


    function shuffleDeck() {

      /*
        Fisher-Yates shuffle
      */

      for (let i = deck.length - 1; i > 0; i--) {

        const j =
          Math.floor(Math.random() * (i + 1));

        [deck[i], deck[j]] =
          [deck[j], deck[i]];

      }

      flashIndex = 0;

      flashCard.classList.remove("flipped");

      updateFlashcard();

    }


    flashCard.addEventListener("click", flipCard);

    flipBtn.addEventListener("click", flipCard);

    nextBtn.addEventListener("click", nextCard);

    prevBtn.addEventListener("click", previousCard);

    shuffleBtn.addEventListener("click", shuffleDeck);


    /*
      Keyboard controls:
      ← Previous
      → Next
      Space = Flip
    */

    document.addEventListener("keydown", event => {

      const tag =
        document.activeElement.tagName.toLowerCase();

      if (tag === "input" || tag === "textarea") {
        return;
      }

      if (event.key === "ArrowRight") {
        nextCard();
      }

      if (event.key === "ArrowLeft") {
        previousCard();
      }

      if (event.code === "Space") {

        event.preventDefault();

        flipCard();

      }

    });


    updateFlashcard();


    /*
      ============================================================
      OPTIONAL: CLICK FLASHCARD BACK/FONT WITHOUT TRIGGERING
      ============================================================
      The whole card intentionally flips when clicked.
    */


  </script>

</body>
</html>
